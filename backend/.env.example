# =========================================================
# MedCore Backend Environment Example (backend/.env)
# Segredos de servidor NUNCA devem ser expostos ao frontend
# =========================================================

APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_DRIVER=sqlite
DB_PATH=storage/database/medcore.sqlite

# Chave JWT de alta entropia (mínimo 32 caracteres)
JWT_SECRET=generate_strong_64_character_hex_key_here
JWT_EXPIRATION=1800

# Integração IA Server-Side
AI_FEATURE_ENABLED=true
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Allowlist
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080
